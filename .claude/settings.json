{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$j=$input|Out-String|ConvertFrom-Json; $f=$j.tool_input.file_path; if($f -and $f.EndsWith('.py')){ruff format $f}"
          }
        ]
      }
    ]
  }
}
